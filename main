        // Shopping Cart State
        let cart = [];

        // Toggle Mobile Menu
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            const icon = document.getElementById('mobile-menu-icon');
            menu.classList.toggle('hidden');
            if(menu.classList.contains('hidden')) {
                icon.className = "fa-solid fa-bars text-2xl";
            } else {
                icon.className = "fa-solid fa-xmark text-2xl";
            }
        }

        // Render Menu Items
        function renderMenu(category = 'all') {
            const grid = document.getElementById('menu-grid');
            grid.innerHTML = '';

            const filtered = category === 'all' ? menuItems : menuItems.filter(item => item.category === category);

            filtered.forEach(item => {
                const card = document.createElement('div');
                card.className = "bg-cream-100 rounded-3xl overflow-hidden border border-cream-300 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group";
                card.innerHTML = `
                    <div class="relative overflow-hidden h-52 bg-cream-200">
                        <img src="${item.image}" alt="${item.name}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" onerror="this.src='https://placehold.co/600x400/3D2314/C5A880?text=Velvet+Crumbs'">
                        <span class="absolute top-3 right-3 bg-chocolate-900/80 backdrop-blur-md text-gold-400 text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider">${item.category}</span>
                    </div>
                    <div class="p-6 flex flex-col flex-1 justify-between space-y-4">
                        <div>
                            <div class="flex justify-between items-start mb-1">
                                <h3 class="font-playfair font-bold text-lg text-chocolate-900">${item.name}</h3>
                                <span class="font-bold text-gold-600">₱${item.price.toFixed(2)}</span>
                            </div>
                            <p class="text-xs text-chocolate-800/70 leading-relaxed">${item.description}</p>
                        </div>
                        <button onclick="addToCart(${item.id})" class="w-full py-2.5 bg-chocolate-900 text-cream-100 rounded-xl text-xs font-semibold hover:bg-gold-500 hover:text-chocolate-900 transition flex items-center justify-center space-x-2">
                            <i class="fa-solid fa-plus"></i>
                            <span>Add to Bag</span>
                        </button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // Filter Menu Categories
        function filterMenu(category) {
            document.querySelectorAll('.filter-btn').forEach(btn => {
                if(btn.getAttribute('data-category') === category) {
                    btn.className = "filter-btn px-6 py-2.5 rounded-full text-sm font-medium transition bg-chocolate-900 text-cream-100 shadow-md";
                } else {
                    btn.className = "filter-btn px-6 py-2.5 rounded-full text-sm font-medium transition bg-cream-100 text-chocolate-900 hover:bg-cream-300 border border-cream-300";
                }
            });
            renderMenu(category);
        }

        // Add to Cart
        function addToCart(id) {
            const product = menuItems.find(item => item.id === id);
            const existing = cart.find(item => item.id === id);

            if(existing) {
                existing.quantity += 1;
            } else {
                cart.push({ ...product, quantity: 1 });
            }

            updateCartUI();
            showToast("Added to bag", `${product.name} has been added.`);
        }

        // Update Cart Quantity
        function updateQuantity(id, change) {
            const item = cart.find(i => i.id === id);
            if(item) {
                item.quantity += change;
                if(item.quantity <= 0) {
                    cart = cart.filter(i => i.id !== id);
                }
            }
            updateCartUI();
        }

        // Update Cart UI & Badges
        function updateCartUI() {
            const container = document.getElementById('cart-items-container');
            const badge = document.getElementById('cart-badge');
            const subtotalEl = document.getElementById('cart-subtotal');
            const taxEl = document.getElementById('cart-tax');
            const totalEl = document.getElementById('cart-total');
            const checkoutBtn = document.getElementById('checkout-btn');

            container.innerHTML = '';

            let totalCount = 0;
            let subtotal = 0;

            if(cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 space-y-3">
                        <i class="fa-solid fa-basket-shopping text-4xl text-chocolate-800/30"></i>
                        <p class="text-xs text-chocolate-800/70 font-medium">Your order bag is currently empty.</p>
                    </div>
                `;
                checkoutBtn.disabled = true;
            } else {
                checkoutBtn.disabled = false;
                cart.forEach(item => {
                    totalCount += item.quantity;
                    subtotal += item.price * item.quantity;

                    const div = document.createElement('div');
                    div.className = "flex items-center justify-between py-4 first:pt-0 last:pb-0";
                    div.innerHTML = `
                        <div class="flex items-center space-x-3">
                            <img src="${item.image}" alt="${item.name}" class="w-14 h-14 object-cover rounded-xl border border-cream-300" onerror="this.src='https://placehold.co/100x100/3D2314/C5A880?text=Item'">
                            <div>
                                <h4 class="font-playfair font-bold text-sm text-chocolate-900">${item.name}</h4>
                                <p class="text-xs text-gold-600 font-semibold">₱${item.price.toFixed(2)}</p>
                            </div>
                        </div>
                        <div class="flex items-center space-x-2">
                            <button onclick="updateQuantity(${item.id}, -1)" class="w-6 h-6 rounded-lg bg-cream-200 text-chocolate-900 hover:bg-cream-300 flex items-center justify-center text-xs font-bold">-</button>
                            <span class="text-xs font-bold text-chocolate-900 w-4 text-center">${item.quantity}</span>
                            <button onclick="updateQuantity(${item.id}, 1)" class="w-6 h-6 rounded-lg bg-cream-200 text-chocolate-900 hover:bg-cream-300 flex items-center justify-center text-xs font-bold">+</button>
                        </div>
                    `;
                    container.appendChild(div);
                });
            }

            if(totalCount > 0) {
                badge.innerText = totalCount;
                badge.classList.remove('scale-0');
            } else {
                badge.classList.add('scale-0');
            }

            const tax = subtotal * 0.12; // 12% VAT in the Philippines
            const total = subtotal + tax;

            subtotalEl.innerText = `₱${subtotal.toFixed(2)}`;
            taxEl.innerText = `₱${tax.toFixed(2)}`;
            totalEl.innerText = `₱${total.toFixed(2)}`;
        }

        // Toggle Cart Drawer
        function toggleCart() {
            const drawer = document.getElementById('cart-drawer');
            const overlay = document.getElementById('cart-overlay');
            
            if(drawer.classList.contains('translate-x-full')) {
                drawer.classList.remove('translate-x-full');
                overlay.classList.remove('hidden');
                setTimeout(() => overlay.classList.remove('opacity-0'), 10);
            } else {
                drawer.classList.add('translate-x-full');
                overlay.classList.add('opacity-0');
                setTimeout(() => overlay.classList.add('hidden'), 300);
            }
        }

        // Checkout Modal Functions
        function openCheckoutModal() {
            toggleCart();
            const modal = document.getElementById('checkout-modal');
            const content = document.getElementById('checkout-modal-content');
            modal.classList.remove('hidden');
            setTimeout(() => content.classList.remove('scale-95'), 10);
        }

        function closeCheckoutModal() {
            const modal = document.getElementById('checkout-modal');
            const content = document.getElementById('checkout-modal-content');
            content.classList.add('scale-95');
            setTimeout(() => modal.classList.add('hidden'), 200);
        }

        function handleCheckoutSubmit(e) {
            e.preventDefault();
            closeCheckoutModal();
            cart = [];
            updateCartUI();
            showToast("Order Confirmed! 🎉", "Your sweet treats are being prepared with love.");
        }

        // Contact Form Submission
        function handleContactSubmit(e) {
            e.preventDefault();
            document.getElementById('contact-form').reset();
            showToast("Message Sent!", "We have received your inquiry and will reply shortly.");
        }

        // Newsletter Submission
        function handleNewsletter(e) {
            e.preventDefault();
            e.target.reset();
            showToast("Subscribed!", "Welcome to the Velvet Crumbs inner circle.");
        }

        // Toast Notification System
        function showToast(title, msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-title').innerText = title;
            document.getElementById('toast-msg').innerText = msg;
            
            toast.classList.remove('translate-y-32', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-32', 'opacity-0');
            }, 3500);
        }

        // Initialize on page load
        window.onload = function() {
            renderMenu('all');
        }
    </script>
</body>
</html>
