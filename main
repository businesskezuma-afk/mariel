                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-chocolate-800 mb-1">Phone Number</label>
                        <input type="tel" required class="w-full px-4 py-2.5 bg-cream-200 border border-cream-300 rounded-xl text-sm focus:outline-none focus:border-gold-500" placeholder="0917-123-4567">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-chocolate-800 mb-1">Payment Method</label>
                        <select class="w-full px-4 py-2.5 bg-cream-200 border border-cream-300 rounded-xl text-sm focus:outline-none focus:border-gold-500 text-chocolate-900">
                            <option>GCash / Maya</option>
                            <option>Cash on Delivery (COD)</option>
                            <option>Credit / Debit Card</option>
                        </select>
                    </div>
                </div>
                <div class="pt-4 border-t border-cream-300 flex justify-end space-x-3">
                    <button type="button" onclick="closeCheckoutModal()" class="px-5 py-2.5 bg-cream-200 text-chocolate-900 rounded-xl text-sm font-medium hover:bg-cream-300 transition">Cancel</button>
                    <button type="submit" class="px-6 py-2.5 bg-chocolate-900 text-cream-100 rounded-xl text-sm font-medium hover:bg-chocolate-800 transition shadow-md">Confirm Order</button>
                </div>
